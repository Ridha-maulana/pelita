{
  "appId": "com.ridha.pelita",
  "appName": "Pelita",
  "webDir": "www",
  "server": {
    "url": "https://ridha-maulana.github.io/pelita/",
    "cleartext": false,
    "allowNavigation": ["ridha-maulana.github.io"]
  },
  "android": { "backgroundColor": "#0d1f1b", "allowMixedContent": false },
  "plugins": {
