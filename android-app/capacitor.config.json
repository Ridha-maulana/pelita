{
  "appId": "com.ridha.pelita",
  "appName": "Pelita",
  "webDir": "www",
  "server": {
    "url": "https://ridha-maulana.github.io/pelita/",
    "cleartext": false,
    "allowNavigation": [
      "ridha-maulana.github.io"
    ],
    "errorPath": "index.html"
  },
  "android": {
    "backgroundColor": "#f5f5f5",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#f5f5f5",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#f5f5f5",
      "style": "LIGHT",
      "overlaysWebView": false
    }
  }
}
